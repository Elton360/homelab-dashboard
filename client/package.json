{
  "name": "server-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:internal": "vite --mode internal",
    "build": "vite build && sudo rm -rf /var/www/server-landing/* && sudo cp -r dist/* /var/www/server-landing/",
    "build:internal": "vite build --mode internal --outDir dist-internal && sudo rm -rf /var/www/server-landing-internal/* && sudo cp -r dist-internal/* /var/www/server-landing-internal/",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/client": "^4.0.0",
    "chart.js": "^4.5.0",
    "date-fns-tz": "^3.2.0",
    "echarts-for-react": "^3.0.2",
    "graphql": "^16.11.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "react-tooltip": "^5.29.1",
    "string-similarity": "^4.0.4",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@rollup/plugin-graphql": "^2.0.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2",
    "vite-plugin-graphql-loader": "^4.0.4"
  }
}
