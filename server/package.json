{
  "name": "server-api",
  "version": "1.0.0",
  "description": "GraphQL server providing all dashbord metrics",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cross-env NODE_ENV=production PORT=4000 pm2 start index.js --name \"server-api\"",
    "start:internal": "cross-env NODE_ENV=production PORT=4001 SHOW_ALL_CONTAINERS=true pm2 start index.js --name \"server-api-internal\"",
    "restart": "pm2 restart server-api",
    "restart:internal": "pm2 restart server-api-internal",
    "dev": "nodemon index.js"
  },
