    "child-process": "^1.0.2",
    "dotenv": "^18.0.4",
    "express": "^4.17.1",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10"
