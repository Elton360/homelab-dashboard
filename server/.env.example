# Copy this file to .env and update the values with your actual configuration

# Jellyfin
JELLYFIN_API_URL=http://localhost:8096
JELLYFIN_USERNAME=your_username
JELLYFIN_PASSWORD=your_password

# Portainer
PORTAINER_API_URL=http://localhost:9000
PORTAINER_USERNAME=your_username
PORTAINER_PASSWORD=your_password

# Prometheus
PROMETHEUS_API_URL=http://localhost:9090

# Pi-hole v6 (optional: leave the URL empty to disable). Pi-hole has no API
# username, only the web interface password or an app password
PIHOLE_API_URL=http://localhost:8080
PIHOLE_PASSWORD=your_password

# Containers the public API instance may return (comma-separated names).
# Leave empty to return all. The internal instance ignores it (SHOW_ALL_CONTAINERS=true)
CONTAINER_ALLOWLIST=portainer,jellyfin,immich_server,nextcloud,pihole
